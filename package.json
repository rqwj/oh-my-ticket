{
  "name": "dsh-oh-my-ticket",
  "version": "0.6.1",
  "description": "DSH ticket management plugin: Epic/Story/Ticket hierarchy backed by SQLite + Markdown",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "prebuild": "rm -rf lib",
    "build": "tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen": "node scripts/gen-bindings.mjs",
    "build:daemon": "node scripts/build-daemon.mjs",
    "sync-version": "node scripts/sync-version.mjs"
  },
  "optionalDependencies": {
    "@oh-my-ticket/darwin-arm64": "0.6.1"
  },
  "devDependencies": {
    "@omt/client-ts": "link:./packages/client-ts",
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/cosmokit": "^1.8.3",
    "@deepseek-ai/dsh-client-connection": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-store": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-input-trigger": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-skill": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.3",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.0.0",
    "js-yaml": "^4.1.0",
    "jsdom": "^24.0.0",
    "json-schema-to-typescript": "^15.0.4",
    "lightningcss": "^1.27.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.16.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0",
    "zod": "^4.4.3"
  }
}
