# Dependencies
node_modules/
.worktrees/

# Build output (tsdown → lib/)
lib/

# Pack artifacts (release tarballs)
*.tgz

# OMT SQLite index — derived from .omt/tickets/*.md, rebuilt by omt_reindex
.omt/omt.db
.omt/omt.db-shm
.omt/omt.db-wal

# OS noise
.DS_Store

# Local symlink to a deepseek-harness checkout (created by pnpm run setup)
.dsh-checkout

# Local pnpm store cache (created when installing with CI=true)
.pnpm-store/

# Logs
*.log
# F-BENCH-18/23：语料库的原始流（历史版本回放的事实源）必须入库——
# 与配对 jsonl 同名（<stem>.raw.log）
!fixtures/harness/**/*.raw.log

# Personal UI preference state (saved tree filters, STORY-0023)
.omt/

# Rust build artifacts and workspace-local cargo home (sandbox-friendly installs)
target/
.cargo-home/
.npm-cache/

# U8/U3: tauri sidecar staging is a build artifact (scripts/copy-sidecar.mjs;
# U3 added the omt CLI as a second sidecar alongside omt-daemon)
apps/desktop/src-tauri/binaries/omt-*
apps/desktop/dist/
