{
  "meta": {
    "name": "report-double-write-status",
    "source": "tests/run-core.spec.ts#terminal derivation + notify-hook fixtures — explicit report double-writes ticket status and item",
    "description": "done/blocked/skipped reports write BOTH item state and ticket status (reported channel bypasses the trust gate); failed touches ONLY the item — the node enum has no failed, so the ticket keeps whatever status it had (open here: a claim dispatches the item without touching the ticket)."
  },
  "setup": {
    "nodes": [
      {
        "type": "epic",
        "title": "批量"
      },
      {
        "type": "story",
        "title": "批次",
        "parentId": "EPIC-0001"
      },
      {
        "type": "ticket",
        "title": "任务1",
        "parentId": "STORY-0001"
      },
      {
        "type": "ticket",
        "title": "任务2",
        "parentId": "STORY-0001"
      }
    ]
  },
  "operations": [
    {
      "op": "createRun",
      "params": {
        "nodeIds": [
          "TICKET-0001",
          "TICKET-0002"
        ]
      }
    },
    {
      "op": "startRun",
      "params": {
        "id": "RUN-0001"
      }
    },
    {
      "op": "claimRunItem",
      "params": {
        "runId": "RUN-0001",
        "executorSessionId": "s1"
      }
    },
    {
      "op": "claimRunItem",
      "params": {
        "runId": "RUN-0001",
        "executorSessionId": "s1"
      }
    },
    {
      "op": "reportRunItem",
      "params": {
        "runId": "RUN-0001",
        "nodeId": "TICKET-0001",
        "outcome": "done"
      }
    },
    {
      "op": "reportRunItem",
      "params": {
        "runId": "RUN-0001",
        "nodeId": "TICKET-0002",
        "outcome": "failed",
        "note": "炸了"
      },
      "label": "failedReport"
    },
    {
      "op": "getNode",
      "params": {
        "id": "TICKET-0001"
      },
      "label": "doneTicket"
    },
    {
      "op": "getNode",
      "params": {
        "id": "TICKET-0002"
      },
      "label": "failedTicket"
    },
    {
      "op": "show",
      "params": {
        "id": "TICKET-0002"
      },
      "label": "failedBody"
    },
    {
      "op": "getRun",
      "params": {
        "id": "RUN-0001"
      },
      "label": "finished"
    }
  ],
  "invariants": [
    {
      "expect": "equals",
      "op": "doneTicket",
      "path": "status",
      "value": "done"
    },
    {
      "expect": "equals",
      "op": "failedReport",
      "path": "item.state",
      "value": "failed"
    },
    {
      "expect": "equals",
      "op": "failedTicket",
      "path": "status",
      "value": "open"
    },
    {
      "expect": "contains",
      "op": "failedBody",
      "path": "body",
      "value": "炸了"
    },
    {
      "expect": "equals",
      "op": "finished",
      "path": "status",
      "value": "completed_with_failures"
    }
  ]
}
