{
  "meta": {
    "name": "dakon-open-over-awaiting",
    "source": "tests/run-core.spec.ts observeNodeStatus — 打回: open over awaiting_confirmation interrupts the item",
    "description": "Reopening the ticket over an unconfirmed completion rejects it: the item falls to interrupted (retry is the way back), never silently done."
  },
  "setup": {
    "nodes": [
      { "type": "epic", "title": "批量" },
      { "type": "story", "title": "批次", "parentId": "EPIC-0001" },
      { "type": "ticket", "title": "任务1", "parentId": "STORY-0001" }
    ]
  },
  "operations": [
    { "op": "createRun", "params": { "nodeIds": ["TICKET-0001"] } },
    { "op": "startRun", "params": { "id": "RUN-0001" } },
    { "op": "claimRunItem", "params": { "runId": "RUN-0001", "executorSessionId": "s1" } },
    { "op": "update", "params": { "id": "TICKET-0001", "status": "done", "executorSessionId": "s1" } },
    { "op": "update", "params": { "id": "TICKET-0001", "status": "open" } },
    { "op": "getRunItem", "params": { "runId": "RUN-0001", "nodeId": "TICKET-0001" }, "label": "rejected" },
    { "op": "getNode", "params": { "id": "TICKET-0001" }, "label": "ticket" }
  ],
  "invariants": [
    { "expect": "equals", "op": "rejected", "path": "state", "value": "interrupted" },
    { "expect": "equals", "op": "ticket", "path": "status", "value": "open" }
  ]
}
