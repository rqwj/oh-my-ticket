{
  "meta": {
    "name": "pause-dispatch-gate",
    "source": "tests/run-core.spec.ts#boundary semantics > pause stops dispatch but in-flight items keep advancing",
    "description": "Paused runs refuse dispatching pending items (dispatch-paused) but let in-flight items finish; the paused run does not auto-complete."
  },
  "setup": {
    "nodes": [
      { "type": "epic", "title": "批量" },
      { "type": "story", "title": "批次", "parentId": "EPIC-0001" },
      { "type": "ticket", "title": "任务1", "parentId": "STORY-0001" },
      { "type": "ticket", "title": "任务2", "parentId": "STORY-0001" }
    ]
  },
  "operations": [
    { "op": "createRun", "params": { "nodeIds": ["TICKET-0001", "TICKET-0002"] } },
    { "op": "startRun", "params": { "id": "RUN-0001" } },
    { "op": "transitionItem", "params": { "runId": "RUN-0001", "nodeId": "TICKET-0001", "to": "running", "executorSessionId": "sess-1" } },
    { "op": "pauseRun", "params": { "id": "RUN-0001" } },
    { "op": "transitionItem", "params": { "runId": "RUN-0001", "nodeId": "TICKET-0002", "to": "running" }, "label": "dispatchWhilePaused" },
    { "op": "transitionItem", "params": { "runId": "RUN-0001", "nodeId": "TICKET-0001", "to": "done" }, "label": "inflightFinishes" },
    { "op": "getRun", "params": { "id": "RUN-0001" }, "label": "still" }
  ],
  "invariants": [
    { "expect": "matches", "op": "dispatchWhilePaused", "path": "error", "value": { "code": "CONFLICT", "details": { "rule": "dispatch-paused", "runStatus": "paused", "itemState": "pending" } } },
    { "expect": "equals", "op": "inflightFinishes", "path": "state", "value": "done" },
    { "expect": "equals", "op": "still", "path": "status", "value": "paused" }
  ]
}
