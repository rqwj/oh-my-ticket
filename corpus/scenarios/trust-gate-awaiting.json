{
  "meta": {
    "name": "trust-gate-awaiting",
    "source": "tests/notify-hook.spec.ts#awaiting_confirmation 待确认提示 + run-core trust gate (TICKET-0064)",
    "description": "Trust gate: only the executor's OWN bare done on its RUNNING item lands awaiting_confirmation (autoVerify=false); reports ride reported=true and land done directly."
  },
  "setup": {
    "nodes": [
      { "type": "epic", "title": "批量" },
      { "type": "story", "title": "批次", "parentId": "EPIC-0001" },
      { "type": "ticket", "title": "任务1", "parentId": "STORY-0001" }
    ]
  },
  "operations": [
    { "op": "createRun", "params": { "nodeIds": ["TICKET-0001"] } },
    { "op": "startRun", "params": { "id": "RUN-0001" } },
    { "op": "claimRunItem", "params": { "runId": "RUN-0001", "executorSessionId": "s1" } },
    { "op": "update", "params": { "id": "TICKET-0001", "status": "done", "executorSessionId": "s1" } },
    { "op": "getRunItem", "params": { "runId": "RUN-0001", "nodeId": "TICKET-0001" }, "label": "gated" },
    { "op": "getRun", "params": { "id": "RUN-0001" }, "label": "midRun" }
  ],
  "invariants": [
    { "expect": "equals", "op": "gated", "path": "state", "value": "awaiting_confirmation" },
    { "expect": "equals", "op": "midRun", "path": "status", "value": "running" }
  ]
}
