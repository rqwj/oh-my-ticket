{
  "meta": {
    "name": "item-lifecycle-timestamps",
    "source": "tests/run-core.spec.ts#item state machine > walks pending → running → done with executor and timestamps",
    "description": "Entering running binds the executor and stamps started_at; a final state stamps finished_at (values masked; presence asserted)."
  },
  "setup": {
    "nodes": [
      { "type": "epic", "title": "批量" },
      { "type": "story", "title": "批次", "parentId": "EPIC-0001" },
      { "type": "ticket", "title": "任务1", "parentId": "STORY-0001" }
    ]
  },
  "operations": [
    { "op": "createRun", "params": { "nodeIds": ["TICKET-0001"] } },
    { "op": "startRun", "params": { "id": "RUN-0001" } },
    { "op": "transitionItem", "params": { "runId": "RUN-0001", "nodeId": "TICKET-0001", "to": "running", "executorSessionId": "sess-1" }, "label": "dispatched" },
    { "op": "transitionItem", "params": { "runId": "RUN-0001", "nodeId": "TICKET-0001", "to": "done" }, "label": "done" }
  ],
  "invariants": [
    { "expect": "equals", "op": "dispatched", "path": "state", "value": "running" },
    { "expect": "equals", "op": "dispatched", "path": "executor_session_id", "value": "sess-1" },
    { "expect": "defined", "op": "dispatched", "path": "started_at" },
    { "expect": "equals", "op": "done", "path": "state", "value": "done" },
    { "expect": "defined", "op": "done", "path": "finished_at" }
  ]
}
