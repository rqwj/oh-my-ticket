  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "gen": "node ../../scripts/gen-bindings.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.0"
  }
}
