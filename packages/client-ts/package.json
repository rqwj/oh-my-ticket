{
  "name": "@omt/client-ts",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript protocol bindings for OMT: generated from schema/*.schema.json (single source of truth).",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
