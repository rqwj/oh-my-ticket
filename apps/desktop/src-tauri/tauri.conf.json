{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "oh-my-ticket",
  "version": "0.2.0",
  "identifier": "com.ohmyticket.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1421",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "oh-my-ticket",
        "width": 1100,
        "height": 760
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "externalBin": ["binaries/omt-daemon"]
  }
}
